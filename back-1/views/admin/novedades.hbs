<h1>Panel de administración</h1>
<p>Bienvenido, {{nombre}}</p>

<table border="1" class="tabla-mensajes">
  <thead>
    <tr>
      <th>Nombre</th>
      <th>Email</th>
      <th>Teléfono</th>
      <th>Mensaje</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    {{#each mensajes}}
    <tr>
      <td>{{this.nombre}}</td>
      <td>{{this.email}}</td>
      <td>{{this.telefono}}</td>
      <td>{{this.mensaje}}</td>
      <td>
        <a href="/admin/novedades/{{this.id}}/editar">Editar</a>  
  <form action="/admin/novedades/{{this.id}}/eliminar" method="POST">
    <button type="submit">Eliminar</button>
  </form>
</td>
    </tr>
    {{/each}}
  </tbody>
</table>
